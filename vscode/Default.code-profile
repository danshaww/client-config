{"name":"Default","settings":"{\"settings\":\"{\\r\\n    \\\"debug.openDebug\\\": \\\"neverOpen\\\",\\r\\n    \\\"editor.tabCompletion\\\": \\\"on\\\",\\r\\n    \\\"powershell.integratedConsole.focusConsoleOnExecute\\\": false,\\r\\n    \\\"files.defaultLanguage\\\": \\\"powershell\\\",\\r\\n    \\\"editor.wordSeparators\\\": \\\"`~!@#%^&*()-=+[{]}\\\\\\\\|;:'\\\\\\\",.<>/?\\\",\\r\\n    \\\"powershell.buttons.showPanelMovementButtons\\\": true,\\r\\n    \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\r\\n    \\\"explorer.confirmDragAndDrop\\\": false,\\r\\n    \\\"window.title\\\": \\\"${dirty}${rootName}${separator}${activeEditorShort}${separator}${profileName}${separator}${appName}\\\",\\r\\n    \\\"editor.wordWrap\\\": \\\"on\\\",\\r\\n    \\\"window.newWindowDimensions\\\": \\\"maximized\\\",\\r\\n    \\\"window.restoreWindows\\\": \\\"none\\\",\\r\\n    \\\"explorer.confirmDelete\\\": false,\\r\\n    \\\"remoteHub.commitDirectlyWarning\\\": \\\"off\\\",\\r\\n    \\\"terminal.integrated.hideOnStartup\\\": \\\"always\\\",\\r\\n    \\\"window.openFilesInNewWindow\\\": \\\"on\\\",\\r\\n    \\\"terminal.integrated.defaultProfile.windows\\\": \\\"PowerShell\\\",\\r\\n    \\\"workbench.panel.opensMaximized\\\": \\\"never\\\",\\r\\n    \\\"security.workspace.trust.enabled\\\": false,\\r\\n    \\\"workbench.settings.applyToAllProfiles\\\": [\\r\\n        \\\"workbench.panel.defaultLocation\\\",\\r\\n        \\\"docker.images.sortBy\\\",\\r\\n        \\\"workbench.editor.restoreViewState\\\",\\r\\n        \\\"terminal.integrated.hideOnStartup\\\"\\r\\n    ],\\r\\n    \\\"git.enableSmartCommit\\\": true,\\r\\n    \\\"git.confirmSync\\\": false,\\r\\n    \\\"git.postCommitCommand\\\": \\\"sync\\\",\\r\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\r\\n    \\\"extensions.supportUntrustedWorkspaces\\\": {},\\r\\n    \\\"git.autofetch\\\": true,\\r\\n    \\\"window.openFoldersInNewWindow\\\": \\\"on\\\",\\r\\n    \\\"git.openAfterClone\\\": \\\"whenNoF