,\\r\\n    \\\"git.openAfterClone\\\": \\\"whenNoFolderOpen\\\",\\r\\n    \\\"extensions.ignoreRecommendations\\\": true,\\r\\n    \\\"docker.images.sortBy\\\": \\\"Label\\\",\\r\\n    \\\"window.confirmSaveUntitledWorkspace\\\": false,\\r\\n    \\\"workbench.editor.restoreViewState\\\": false,\\r\\n    \\\"terminal.integrated.confirmOnKill\\\": \\\"never\\\",\\r\\n    \\\"commands.commands\\\": {\\r\\n        \\\"Todo - Mark In Progress\\\": {\\r\\n            \\\"icon\\\": \\\"check\\\",\\r\\n            \\\"sequence\\\": [\\r\\n                \\\"editor.action.insertSnippet\\\",\\r\\n                \\\"saveAll\\\"\\r\\n            ],\\r\\n            \\\"statusBar\\\": {\\r\\n                \\\"text\\\": \\\"Todo - Mark in Progress\\\",\\r\\n                \\\"hidden\\\": true\\r\\n            }\\r\\n        },\\r\\n        \\\"Todo - Complete\\\": {\\r\\n            \\\"icon\\\": \\\"check\\\",\\r\\n            \\\"sequence\\\": [\\r\\n                \\\"extension.toggleCompletion\\\",\\r\\n                \\\"saveAll\\\"\\r\\n            ],\\r\\n            \\\"statusBar\\\": {\\r\\n                \\\"text\\\": \\\"Todo - Complete\\\",\\r\\n                \\\"hidden\\\": true\\r\\n            }\\r\\n        },\\r\\n        \\\"Todo - Archive\\\": {\\r\\n            \\\"icon\\\": \\\"check\\\",\\r\\n            \\\"sequence\\\": [\\r\\n                \\\"extension.archiveTasks\\\",\\r\\n                \\\"saveAll\\\"\\r\\n            ]\\r\\n        },\\r\\n        \\\"Todo - Complete & Archive\\\": {\\r\\n            \\\"icon\\\": \\\"check\\\",\\r\\n            \\\"sequence\\\": [\\r\\n                \\\"extension.toggleCompletion\\\",\\r\\n                \\\"saveAll\\\",\\r\\n                \\\"extension.archiveTasks\\\",\\r\\n                \\\"saveAll\\\"\\r\\n            ],\\r\\n            \\\"statusBar\\\": {\\r\\n                \\\"text\\\": \\\"Done\\\",\\r\\n                \\\"hidden\\\": true\\r\\n            }\\r\\n        },\\r\\n        \\\"Todo - Move to Backlog\\\": {\\r\\n            \\\"icon\\\": \\\"check\\\",\\r\\n            \\\"sequence\\\": [\\r\\n                \\\"extension.moveTasksToSomeday\\\",\\r\\n                \\\"saveAll\\\"\\r\\n            ],\\r\\n            \\\"statusBar\\\": {\\r\\n                \\\"text\\\": \\\"Backlog\\\",\\r\\n                \\\"hidden\\\": true\\r\\n            }\\r\\n        },\\r\\n        \\\"Todo - Move to ToDo\\\": {\\r\\n            \\\"icon\\\": \\\"check\\\",\\r\\n            \\\"sequence\\\": [\\r\\n                \\\"extension.moveTasksToTodo\\\",\\r\\n                \\\"saveAll\\\"\\r\\n            ]\\r\\n        }\\r\\n    },\\r\\n    \\\"window.autoDetectColorScheme\\\": true,\\r\\n    \\\"git.ignoreRebaseWarning\\\": true,\\r\\n    \\\"editor.smoothScrolling\\\": true,\\r\\n    \\\"git.openRepositoryInParentFolders\\\": \\\"never\\\",\\r\\n    \\\"fonted.font\\\": \\\"Ubuntu Default\\\",\\r\\n    \\\"workbench.editor.wrapTabs\\\": true,\\r\\n    \\\"commands.workspaceCommands\\\": {\\r\\n\\r\\n    },\\r\\n    \\\"workbench.layoutControl.enabled\\\": false,\\r\\n    \\\"explorer.compactFolders\\\": false,\\r\\n    \\\"tabnine.experimentalAutoImports\\\": true,\\r\\n    \\\"vaultEditor.decryptOnStartup\\\": false,\\r\\n    \\\"vaultEditor.decryptOnOpen\\\": false,\\r\\n    \\\"remote.autoForwardPortsSource\\\": \\\"hybrid\\\",\\r\\n    \\\"git.replaceTagsWhenPull\\\": true,\\r\\n    \\\"window.commandCenter\\\": false,\\r\\n    \\\"gitlens.advanced.externalDiffTool\\\": \\\"\\\",\\r\\n    \\\"files.associations\\\": {\\r\\n        \\\"*.yml.j2\\\": \\\"yaml\\\",\\r\\n        \\\"*.zone.j2\\\": \\\"zone\\\",\\r\\n        \\\"*.conf.j2\\\": \\\"conf\\\"\\r\\n    },\\r\\n\\\"window.titleBarStyle\\\": \\\"custom\\\",\\r\\n\\\"gitlens.codeLens.authors.enabled\\\": false,\\r\\n\\\"gitlens.codeLens.recentChange.enabled\\\": false,\\r\\n\\\"vaultEditor.ansibleCfgPath\\\": \\\"/home/dan/git/ansible-core/ansible.cfg\\\",\\r\\n\\\"redhat.tel