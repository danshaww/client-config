{"name":"Default","settings":"{\"settings\":\"{\\r\\n    \\\"vsicons.dontShowNewVersionMessage\\\": true,\\r\\n    \\\"debug.openDebug\\\": \\\"neverOpen\\\",\\r\\n    \\\"editor.tabCompletion\\\": \\\"on\\\",\\r\\n    \\\"powershell.integratedConsole.focusConsoleOnExecute\\\": false,\\r\\n    \\\"files.defaultLanguage\\\": \\\"powershell\\\",\\r\\n    \\\"editor.wordSeparators\\\": \\\"`~!@#%^&*()-=+[{]}\\\\\\\\|;:'\\\\\\\",.<>/?\\\",\\r\\n    \\\"powershell.buttons.showPanelMovementButtons\\\": true,\\r\\n    \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\r\\n    \\\"explorer.confirmDragAndDrop\\\": false,\\r\\n    \\\"system-info.hideBatteryStatus\\\": true,\\r\\n    \\\"system-info.memoryUsageAsPercentage\\\": true,\\r\\n    \\\"docker.containers.description\\\": [\\r\\n        \\\"Image\\\",\\r\\n        \\\"Status\\\"\\r\\n    ],\\r\\n    \\\"window.title\\\": \\\"${dirty}${rootName}${separator}${activeEditorShort}${separator}${profileName}${separator}${appName}\\\",\\r\\n    \\\"editor.wordWrap\\\": \\\"on\\\",\\r\\n    \\\"settingsSync.ignoredSettings\\\": [\\r\\n        \\\"-security.allowedUNCHosts\\\",\\r\\n        \\\"editor.smoothScrolling\\\",\\r\\n        \\\"editor.mouseWheelScrollSensitivity\\\",\\r\\n        \\\"workbench.list.mouseWheelScrollSensitivity\\\",\\r\\n        \\\"terminal.integrated.mouseWheelScrollSensitivity\\\",\\r\\n        \\\"-git.defaultCloneDirectory\\\",\\r\\n        \\\"fonted.font\\\"\\r\\n    ],\\r\\n    \\\"window.newWindowDimensions\\\": \\\"maximized\\\",\\r\\n    \\\"window.restoreWindows\\\": \\\"none\\\",\\r\\n    \\\"explorer.confirmDelete\\\": false,\\r\\n    \\\"remoteHub.commitDirectlyWarning\\\": \\\"off\\\",\\r\\n    \\\"terminal.integrated.hideOnStartup\\\": \\\"always\\\",\\r\\n    \\\"window.openFilesInNewWindow\\\": \\\"on\\\",\\r\\n    \\\"terminal.integrated.defaultProfile.windows\\\": \\\"Ubuntu-24.04 (WSL)\\\",\\r\\n    \\\"workbench.panel.opensMaximized\\\": \\\"never\\\",\\r\\n    \\\"