mpactFolders\\\": false,\\r\\n    \\\"tabnine.experimentalAutoImports\\\": true,\\r\\n    \\\"vaultEditor.decryptOnStartup\\\": false,\\r\\n    \\\"vaultEditor.decryptOnOpen\\\": false,\\r\\n    \\\"remote.autoForwardPortsSource\\\": \\\"hybrid\\\",\\r\\n    \\\"git.replaceTagsWhenPull\\\": true,\\r\\n    \\\"window.commandCenter\\\": false,\\r\\n    \\\"gitlens.advanced.externalDiffTool\\\": \\\"\\\",\\r\\n    \\\"files.associations\\\": {\\r\\n        \\\"*.yml.j2\\\": \\\"yaml\\\",\\r\\n        \\\"*.zone.j2\\\": \\\"zone\\\",\\r\\n        \\\"*.conf.j2\\\": \\\"conf\\\"\\r\\n    },\\r\\n\\\"window.titleBarStyle\\\": \\\"custom\\\",\\r\\n\\\"gitlens.codeLens.authors.enabled\\\": false,\\r\\n\\\"gitlens.codeLens.recentChange.enabled\\\": false,\\r\\n\\\"vaultEditor.ansibleCfgPath\\\": \\\"/home/dan/git/ansible-core/ansible.cfg\\\",\\r\\n\\\"redhat.telemetry.enabled\\\": false,\\r\\n\\\"github.copilot.enable\\\": {\\r\\n    \\\"*\\\": false,\\r\\n    \\\"plaintext\\\": false,\\r\\n    \\\"markdown\\\": false,\\r\\n    \\\"scminput\\\": false,\\r\\n    \\\"ansible\\\": false\\r\\n},\\r\\n\\\"ansible.lightspeed.enabled\\\": false,\\r\\n\\\"ansible.lightspeed.suggestions.enabled\\\": false,\\r\\n\\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\r\\n\\\"containers.containers.description\\\": [\\r\\n    \\\"Image\\\",\\r\\n    \\\"Status\\\"\\r\\n],\\r\\n\\\"containers.containers.label\\\": \\\"ContainerName\\\",\\r\\n\\\"containers.containers.sortBy\\\": \\\"Label\\\",\\r\\n\\\"containers.images.sortBy\\\": \\\"Label\\\",\\r\\n\\\"scm.defaultViewMode\\\": \\\"tree\\\",\\r\\n\\\"remote.defaultExtensionsIfInstalledLocally\\\": [\\r\\n    \\\"redhat.ansible\\\",\\r\\n    \\\"dhoeric.ansible-vault\\\",\\r\\n    \\\"ms-azuretools.vscode-docker\\\",\\r\\n    \\\"mhutchie.git-graph\\\",\\r\\n    \\\"donjayamanne.githistory\\\",\\r\\n    \\\"hashicorp.terraform\\\",\\r\\n    \\\"george-alisson.html-preview-vscode\\\",\\r\\n    \\\"oderwat.indent-rainbow\\\",\\r\\n    